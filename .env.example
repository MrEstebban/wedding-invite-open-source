# Copia este archivo a .env.local (desarrollo) y configura los mismos valores en Vercel (producción).
# NUNCA subas .env.local al repositorio.

# Email de la service account de Google Cloud (la hoja debe estar compartida con este email como Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=invitaciones@mi-proyecto.iam.gserviceaccount.com

# Clave privada de la service account, entre comillas y con los saltos de línea escapados como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID de la hoja: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789

# Nombre de la pestaña con los invitados
GOOGLE_SHEET_TAB=Invitados

# URL pública del sitio, usada por `npm run tokens` para generar los enlaces personales
PUBLIC_BASE_URL=https://nuestra-boda.vercel.app
